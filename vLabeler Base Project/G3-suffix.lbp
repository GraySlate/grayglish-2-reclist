{
    "version": 3,
    "rootSampleDirectory": "D:\\D Drive\\Voicebanks\\Ichiko Honda CVVC English vlabeler\\G3",
    "workingDirectory": "D:\\D Drive\\Documents\\GrayGlish 2 Reclist Package\\vLabeler Base Project",
    "projectName": "G3-suffix",
    "cacheDirectory": "D:\\D Drive\\Documents\\GrayGlish 2 Reclist Package\\vLabeler Base Project\\G3-suffix.lbp.caches",
    "labelerConf": {
        "name": "oto-plus.default",
        "version": 30,
        "serialVersion": 2,
        "singleFile": false,
        "extension": "ini",
        "defaultInputFilePath": "oto.ini",
        "displayedName": {
            "en": "UTAU oto labeler",
            "zh": "UTAU oto 标注器",
            "ja": "UTAU oto ラベラー",
            "ko": "UTAU oto 라벨러"
        },
        "author": "sdercolin",
        "email": "sder.colin@gmail.com",
        "description": {
            "en": "Default labeler for UTAU oto.",
            "zh": "用于 UTAU oto 的默认标注器。",
            "ja": "UTAU oto のデフォルトラベラー。",
            "ko": "기본 내장된 UTAU oto용 라벨러에요."
        },
        "website": "https://github.com/sdercolin/vlabeler/tree/main/resources/common/labelers",
        "categoryTag": "UTAU",
        "displayOrder": 1,
        "continuous": false,
        "allowSameNameEntry": false,
        "defaultEntryName": null,
        "defaultValues": [
            100.0,
            400.0,
            300.0,
            200.0,
            100.0,
            500.0
        ],
        "defaultExtras": null,
        "fields": [
            {
                "name": "fixed",
                "label": {
                    "en": "Fixed",
                    "zh": "固",
                    "ja": "子",
                    "ko": "고정"
                },
                "color": "#1b51ff",
                "height": 0.5,
                "dragBase": false,
                "filling": "left",
                "constraints": [
                    {
                        "min": 3,
                        "max": null
                    }
                ],
                "shortcutIndex": 3,
                "replaceStart": false,
                "replaceEnd": false,
                "triggerPostEditNext": false,
                "triggerPostEditDone": true
            },
            {
                "name": "preu",
                "label": {
                    "en": "Preu",
                    "zh": "先",
                    "ja": "先",
                    "ko": "선행"
                },
                "color": "#ff1a45",
                "height": 0.6667,
                "dragBase": true,
                "filling": null,
                "constraints": [
                    {
                        "min": 3,
                        "max": 0
                    }
                ],
                "shortcutIndex": 2,
                "replaceStart": false,
                "replaceEnd": false,
                "triggerPostEditNext": false,
                "triggerPostEditDone": true
            },
            {
                "name": "ovl",
                "label": {
                    "en": "Ovl",
                    "zh": "重",
                    "ja": "オ",
                    "ko": "오버"
                },
                "color": "#7fff39",
                "height": 0.8333,
                "dragBase": false,
                "filling": null,
                "constraints": [
                    {
                        "min": null,
                        "max": 0
                    }
                ],
                "shortcutIndex": 1,
                "replaceStart": false,
                "replaceEnd": false,
                "triggerPostEditNext": false,
                "triggerPostEditDone": true
            },
            {
                "name": "left",
                "label": {
                    "en": "Left",
                    "zh": "左",
                    "ja": "左",
                    "ko": "왼쪽"
                },
                "color": "#9c7212",
                "height": 0.9,
                "dragBase": false,
                "filling": "start",
                "constraints": [
                ],
                "shortcutIndex": null,
                "replaceStart": true,
                "replaceEnd": false,
                "triggerPostEditNext": false,
                "triggerPostEditDone": false
            }
        ],
        "extraFieldNames": [
            "rawRight"
        ],
        "extraFields": [
            {
                "name": "rawRight",
                "default": "500",
                "displayedName": "Raw right",
                "isVisible": false,
                "isEditable": false,
                "isOptional": false
            }
        ],
        "moduleExtraFields": [
        ],
        "lockedDrag": {
            "useDragBase": true,
            "useStart": false
        },
        "overflowBeforeStart": "AdjustBorder",
        "overflowAfterEnd": "AdjustBorder",
        "postEditNextTrigger": {
            "useStart": false,
            "useEnd": false
        },
        "postEditDoneTrigger": {
            "useStart": true,
            "useEnd": true
        },
        "decimalDigit": 2,
        "entrySimilarityWeights": {
            "name": 6.0,
            "sample": 12.0,
            "start": 1.0,
            "end": 1.0,
            "points": [
                1.0,
                1.0,
                1.0,
                1.0
            ],
            "extras": [
                0.0
            ],
            "tag": 0.0,
            "threshold": 0.75
        },
        "properties": [
            {
                "name": "left",
                "displayedName": {
                    "en": "Offset",
                    "zh": "左边界",
                    "ja": "左ブランク",
                    "ko": "오프셋"
                },
                "valueGetter": [
                    "value = entry.points[3]",
                    ""
                ],
                "valueSetter": [
                    "entry.points[3] = value",
                    "if (value < entry.start) {",
                    "    entry.start = value",
                    "}",
                    ""
                ],
                "shortcutIndex": 0
            },
            {
                "name": "ovl",
                "displayedName": {
                    "en": "Overlap",
                    "zh": "重叠",
                    "ja": "オーバーラップ",
                    "ko": "오버랩"
                },
                "valueGetter": [
                    "value = entry.points[2] - entry.points[3]",
                    ""
                ],
                "valueSetter": [
                    "newOverlap = value + entry.points[3]",
                    "entry.points[2] = newOverlap",
                    "if (newOverlap < entry.start) {",
                    "    entry.start = newOverlap",
                    "}",
                    ""
                ],
                "shortcutIndex": 1
            },
            {
                "name": "preu",
                "displayedName": {
                    "en": "Preutterance",
                    "zh": "先行发声",
                    "ja": "先行発声",
                    "ko": "선행자음부"
                },
                "valueGetter": [
                    "value = entry.points[1] - entry.points[3]",
                    ""
                ],
                "valueSetter": [
                    "entry.points[1] = value + entry.points[3]",
                    ""
                ],
                "shortcutIndex": 2
            },
            {
                "name": "fixed",
                "displayedName": {
                    "en": "Fixed",
                    "zh": "固定",
                    "ja": "固定範囲",
                    "ko": "고정자음부"
                },
                "valueGetter": [
                    "value = entry.points[0] - entry.points[3]",
                    ""
                ],
                "valueSetter": [
                    "entry.points[0] = value + entry.points[3]",
                    ""
                ],
                "shortcutIndex": 3
            },
            {
                "name": "right",
                "displayedName": {
                    "en": "Cutoff",
                    "zh": "右边界",
                    "ja": "右ブランク",
                    "ko": "컷오프"
                },
                "valueGetter": [
                    "if (entry.needSync || entry.end < 0) {",
                    "    value = parseFloat(entry.extras[0])",
                    "} else {",
                    "    value = entry.points[3] - entry.end",
                    "}",
                    ""
                ],
                "valueSetter": [
                    "if (value < 0) {",
                    "    entry.end = -value + entry.points[3]",
                    "} else {",
                    "    entry.needSync = true",
                    "    entry.end = -value",
                    "    entry.extras[0] = value.toString()",
                    "}",
                    ""
                ],
                "shortcutIndex": 4
            }
        ],
        "parser": {
            "scope": "Entry",
            "defaultEncoding": "Shift-JIS",
            "extractionPattern": "(.*)=(.*),(.*),(.*),(.*),(.*),(.*)",
            "variableNames": [
                "sample",
                "name",
                "left",
                "fixed",
                "right",
                "preu",
                "ovl"
            ],
            "scripts": [
                "if (typeof sample === 'undefined' || !sample) {",
                "    error('Sample name is empty.')",
                "}",
                "if (typeof sample === 'undefined' || !name) {",
                "    name = getNameWithoutExtension(sample)",
                "}",
                "offset = 0",
                "if (ovl === '') {",
                "    ovl = '0'",
                "}",
                "ovl = parseFloat(ovl)",
                "if (ovl < 0) {",
                "    offset = -ovl",
                "}",
                "if (left === '') {",
                "    left = '0'",
                "}",
                "left = parseFloat(left)",
                "start = left - offset",
                "points = []",
                "extras = []",
                "if (fixed === '') {",
                "    fixed = '0'",
                "}",
                "fixed = parseFloat(fixed)",
                "if (fixed < 0) {",
                "    fixed = 0",
                "}",
                "points.push(fixed + left)",
                "if (right === '') {",
                "    right = '0'",
                "}",
                "right = parseFloat(right)",
                "rawRight = right // for restoring from a non-negative value (distance to sample end)",
                "extras.push(rawRight)",
                "if (right < 0) {",
                "    end = left - right",
                "} else {",
                "    end = -right",
                "}",
                "if (preu === '') {",
                "    preu = '0'",
                "}",
                "preu = parseFloat(preu)",
                "if (preu < 0) {",
                "    preu = 0",
                "}",
                "points.push(preu + left)",
                "points.push(ovl + left)",
                "points.push(left)",
                "needSync = right >= 0",
                "entry = new Entry(sample, name, start, end, points, extras, new Notes(), needSync)",
                ""
            ]
        },
        "writer": {
            "scope": "Entry",
            "format": "{sample}={name},{left},{fixed},{right},{preu},{ovl}",
            "scripts": null
        },
        "parameters": [
            {
                "parameter": {
                    "type": "boolean",
                    "name": "useNegativeOvl",
                    "label": {
                        "en": "Allow negative overlap",
                        "zh": "允许重叠为负值",
                        "ja": "オーバーラップのマイナス値を許容する",
                        "ko": "오버랩 음수값 허용하기"
                    },
                    "description": null,
                    "enableIf": null,
                    "defaultValue": true
                },
                "injector": [
                    "labeler.fields[2].constraints[0].min = value ? null : 3",
                    ""
                ],
                "changeable": true
            },
            {
                "parameter": {
                    "type": "enum",
                    "name": "dragBase",
                    "label": {
                        "en": "Base for fixed-drag",
                        "zh": "锁定拖动的基准参数",
                        "ja": "連動ドラッグの基準",
                        "ko": "고정 드래그의 기준 마커"
                    },
                    "description": null,
                    "enableIf": null,
                    "defaultValue": "Preutterance",
                    "options": [
                        "Left",
                        "Overlap",
                        "Preutterance",
                        "Fixed"
                    ],
                    "optionDisplayedNames": [
                        {
                            "en": "Left",
                            "zh": "左边界",
                            "ja": "左ブランク",
                            "ko": "왼쪽 끝"
                        },
                        {
                            "en": "Overlap",
                            "zh": "重叠",
                            "ja": "オーバーラップ",
                            "ko": "오버랩"
                        },
                        {
                            "en": "Preutterance",
                            "zh": "先行发声",
                            "ja": "先行発声",
                            "ko": "선행자음부"
                        },
                        {
                            "en": "Fixed",
                            "zh": "固定",
                            "ja": "固定範囲",
                            "ko": "고정자음부"
                        }
                    ]
                },
                "injector": [
                    "if (value !== 'Preutterance') {",
                    "    labeler.fields[1].dragBase = false",
                    "}",
                    "if (value === 'Fixed') {",
                    "    labeler.fields[0].dragBase = true",
                    "}",
                    "if (value === 'Overlap') {",
                    "    labeler.fields[2].dragBase = true",
                    "}",
                    "if (value === 'Left') {",
                    "    labeler.lockedDrag.useDragBase = false",
                    "    labeler.lockedDrag.useStart = true",
                    "}",
                    ""
                ],
                "changeable": true
            },
            {
                "parameter": {
                    "type": "enum",
                    "name": "postEditNextTrigger",
                    "label": {
                        "en": "Go to next entry after editing",
                        "zh": "编辑后跳转到下一个条目",
                        "ja": "編集後に次のエントリーに移動する",
                        "ko": "편집이 끝나면 다음 엔트리로 이동"
                    },
                    "description": {
                        "en": "Please enable this action in `Preferences` -> `Editor` -> `Post-editing actions`, and choose `Use settings defined by the labeler` as the trigger.",
                        "zh": "请在`环境设置`->`编辑器`->`编辑后动作`中启用此功能，并选择`使用标注器的设置`为`触发该行为的参数`。",
                        "ja": "`環境設定`->`エディタ`->`編集後アクション`でこの機能を有効にし、`アクションを実行できるパラメータ`では`ラベラーの設定`を選択してください。",
                        "ko": "활성화하려면 `환경설정` -> `에디터` -> `사전편집 동작`을 누른 후, `라벨러에 의해 정의된 설정 사용`을 선택해 주세요."
                    },
                    "enableIf": null,
                    "defaultValue": "Disable",
                    "options": [
                        "Disable",
                        "Left",
                        "Overlap",
                        "Preutterance",
                        "Fixed",
                        "Cutoff",
                        "Any"
                    ],
                    "optionDisplayedNames": [
                        {
                            "en": "Disable",
                            "zh": "禁用",
                            "ja": "無効",
                            "ko": "비활성"
                        },
                        {
                            "en": "Left",
                            "zh": "左边界",
                            "ja": "左ブランク",
                            "ko": "왼쪽 끝"
                        },
                        {
                            "en": "Overlap",
                            "zh": "重叠",
                            "ja": "オーバーラップ",
                            "ko": "오버랩"
                        },
                        {
                            "en": "Preutterance",
                            "zh": "先行发声",
                            "ja": "先行発声",
                            "ko": "선행자음부"
                        },
                        {
                            "en": "Fixed",
                            "zh": "固定",
                            "ja": "固定範囲",
                            "ko": "고정자음부"
                        },
                        {
                            "en": "Cutoff",
                            "zh": "右边界",
                            "ja": "右ブランク",
                            "ko": "컷오프"
                        },
                        {
                            "en": "Any",
                            "zh": "任意",
                            "ja": "任意",
                            "ko": "아무거나"
                        }
                    ]
                },
                "injector": [
                    "if (value === 'Left') {",
                    "    labeler.postEditNextTrigger = {'useStart': true}",
                    "}",
                    "if (value === 'Fixed') {",
                    "    labeler.fields[0].triggerPostEditNext = true",
                    "}",
                    "if (value === 'Preutterance') {",
                    "    labeler.fields[1].triggerPostEditNext = true",
                    "}",
                    "if (value === 'Overlap') {",
                    "    labeler.fields[2].triggerPostEditNext = true",
                    "}",
                    "if (value === 'Cutoff') {",
                    "    labeler.postEditNextTrigger = {'useEnd': true}",
                    "}",
                    "if (value === 'Any') {",
                    "    labeler.postEditNextTrigger = {'useStart': true, 'useEnd': true}",
                    "    labeler.fields[0].triggerPostEditNext = true",
                    "    labeler.fields[1].triggerPostEditNext = true",
                    "    labeler.fields[2].triggerPostEditNext = true",
                    "}",
                    ""
                ],
                "changeable": true
            },
            {
                "parameter": {
                    "type": "enum",
                    "name": "postEditDoneTrigger",
                    "label": {
                        "en": "Mark entry as `Done` after editing",
                        "zh": "编辑后标记为已完成条目",
                        "ja": "編集後にエントリーを\"完了\"にする",
                        "ko": "편집된 엔트리에 자동으로 \"완료\" 표시"
                    },
                    "description": {
                        "en": "Please enable this action in `Preferences` -> `Editor` -> `Post-editing actions`, and choose `Use settings defined by the labeler` as the trigger.",
                        "zh": "请在`环境设置`->`编辑器`->`编辑后动作`中启用此功能，并选择`使用标注器的设置`为`触发该行为的参数`。",
                        "ja": "`環境設定`->`エディタ`->`編集後アクション`でこの機能を有効にし、`アクションを実行できるパラメータ`では`ラベラーの設定`を選択してください。",
                        "ko": "활성화하려면 `환경설정` -> `에디터` -> `사전편집 동작`을 누른 후, `라벨러에 의해 정의된 설정 사용`을 선택해 주세요."
                    },
                    "enableIf": null,
                    "defaultValue": "Any",
                    "options": [
                        "Disable",
                        "Left",
                        "Overlap",
                        "Preutterance",
                        "Fixed",
                        "Cutoff",
                        "Any"
                    ],
                    "optionDisplayedNames": [
                        {
                            "en": "Disable",
                            "zh": "禁用",
                            "ja": "無効",
                            "ko": "비활성"
                        },
                        {
                            "en": "Left",
                            "zh": "左边界",
                            "ja": "左ブランク",
                            "ko": "왼쪽 끝"
                        },
                        {
                            "en": "Overlap",
                            "zh": "重叠",
                            "ja": "オーバーラップ",
                            "ko": "오버랩"
                        },
                        {
                            "en": "Preutterance",
                            "zh": "先行发声",
                            "ja": "先行発声",
                            "ko": "선행자음부"
                        },
                        {
                            "en": "Fixed",
                            "zh": "固定",
                            "ja": "固定範囲",
                            "ko": "고정자음부"
                        },
                        {
                            "en": "Cutoff",
                            "zh": "右边界",
                            "ja": "右ブランク",
                            "ko": "컷오프"
                        },
                        {
                            "en": "Any",
                            "zh": "任意",
                            "ja": "任意",
                            "ko": "아무거나"
                        }
                    ]
                },
                "injector": [
                    "if (value === 'Disable') {",
                    "    labeler.postEditDoneTrigger = {}",
                    "    labeler.fields[0].triggerPostEditDone = false",
                    "    labeler.fields[1].triggerPostEditDone = false",
                    "    labeler.fields[2].triggerPostEditDone = false",
                    "}",
                    "if (value === 'Left') {",
                    "    labeler.postEditDoneTrigger = {'useStart': true}",
                    "    labeler.fields[0].triggerPostEditDone = false",
                    "    labeler.fields[1].triggerPostEditDone = false",
                    "    labeler.fields[2].triggerPostEditDone = false",
                    "}",
                    "if (value === 'Fixed') {",
                    "    labeler.postEditDoneTrigger = {}",
                    "    labeler.fields[1].triggerPostEditDone = false",
                    "    labeler.fields[2].triggerPostEditDone = false",
                    "}",
                    "if (value === 'Preutterance') {",
                    "    labeler.postEditDoneTrigger = {}",
                    "    labeler.fields[0].triggerPostEditDone = false",
                    "    labeler.fields[2].triggerPostEditDone = false",
                    "}",
                    "if (value === 'Overlap') {",
                    "    labeler.postEditDoneTrigger = {}",
                    "    labeler.fields[0].triggerPostEditDone = false",
                    "    labeler.fields[1].triggerPostEditDone = false",
                    "}",
                    "if (value === 'Cutoff') {",
                    "    labeler.postEditDoneTrigger = {'useEnd': true}",
                    "    labeler.fields[0].triggerPostEditDone = false",
                    "    labeler.fields[1].triggerPostEditDone = false",
                    "    labeler.fields[2].triggerPostEditDone = false",
                    "}",
                    ""
                ],
                "changeable": true
            }
        ],
        "projectConstructor": null,
        "quickProjectBuilders": [
            {
                "name": "default",
                "displayedName": {
                    "en": "Edit UTAU oto file",
                    "zh": "编辑 UTAU oto 文件",
                    "ja": "UTAU oto を編集する",
                    "ko": "UTAU oto 파일 편집"
                },
                "description": {
                    "en": "Select your UTAU oto file to start quick editing.",
                    "zh": "选择您的 UTAU oto 文件以开始快捷编辑。",
                    "ja": "UTAU oto ファイルを選択して、クイック編集を開始します。",
                    "ko": "UTAU oto 파일을 선택하여 빠른 편집을 시작합니다."
                },
                "extension": "ini",
                "scripts": [
                    "console.log(\"input=\", JSON.stringify(input))",
                    "console.log(\"savedParams=\", JSON.stringify(savedParams))",
                    "",
                    "sampleDirectory = input.getParentFile()",
                    "inputName = input.getNameWithoutExtension()",
                    "projectName = sampleDirectory.getName() + \"_\" + inputName + \"_quickedit.lbp\"",
                    "projectFile = sampleDirectory.resolve(projectName)",
                    "encoding = \"Shift-JIS\"",
                    ""
                ]
            }
        ],
        "resourceFiles": [
        ]
    },
    "labelerParams": null,
    "encoding": "Shift-JIS",
    "multipleEditMode": false,
